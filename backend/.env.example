# Copy to .env on the server. Never commit real .env.

# --- Site (API redirects GET /admin → storefront) ---
FRONTEND_URL=https://nidhamauto.shop

# --- Database ---
# Prefer POSTGRES_* (password is URL-encoded for asyncpg automatically).
# Leave POSTGRES_PASSWORD empty ONLY if you set DATABASE_URL yourself (postgresql+asyncpg://...).
#
# Docker Compose: root .env uses POSTGRES_PASSWORD for the db service; compose also passes the same
# value into backend — keep backend POSTGRES_* in sync or rely on compose `environment:` overrides.
POSTGRES_USER=nidhamauto
# Must match docker-compose/db and project root `.env` POSTGRES_PASSWORD when using Compose.
POSTGRES_PASSWORD=nidhamauto
# Dev on host vs Docker-published 5432: 127.0.0.1 | Compose sets POSTGRES_HOST=db inside backend.
POSTGRES_HOST=127.0.0.1
# External / PaaS: set the exact DB hostname from your provider.
POSTGRES_PORT=5432
POSTGRES_DB=nidhamauto
#
# PLATFORM_URL shortcuts (optional): pasted postgres:// URLs are rewritten to postgresql+asyncpg:// at runtime.
# DATABASE_URL=postgresql+asyncpg://nidhamauto:password@db:5432/nidhamauto

# --- Admin dashboard login (JWT) ---
ADMIN_USERNAME=change_me_login
ADMIN_PASSWORD=change_me_strong_password
# Prefer a dedicated long random secret; must be ≥8 chars (else falls back to SECRET_KEY)
ADMIN_JWT_SECRET=
SECRET_KEY=change-me-to-long-random-string

# --- Saudi / VPN quality (counts only traffic_valid=true when rules pass) ---
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
IPQUALITYSCORE_API_KEY=
# Local dev ONLY — never true in production
TRAFFIC_TRUST_PRIVATE_IP=false

# --- Orders webhook & ops ---
GOOGLE_SHEETS_WEBHOOK_URL=
WHITELISTED_PHONES=+966550603

# --- Optional CAPI (existing app) ---
META_ACCESS_TOKEN=
META_PIXEL_ID=
META_TEST_EVENT_CODE=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
SNAP_ACCESS_TOKEN=
SNAP_PIXEL_ID=

{
  "name": "nidhamauto-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-dev-ports.mjs storefront",
    "dev": "concurrently -n web,express,fastapi \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:backend\"",
    "dev:storefront": "node scripts/free-dev-ports.mjs storefront && concurrently -n web,express \"npm:dev:web\" \"npm:dev:api\"",
    "dev:fresh": "node scripts/free-dev-ports.mjs all && npm run dev",
    "dev:free": "node scripts/free-dev-ports.mjs storefront",
    "dev:free:all": "node scripts/free-dev-ports.mjs all",
    "db:up": "docker compose up db -d --wait",
    "docker:backend": "docker compose up -d --build db backend",
    "verify:docker-backend": "docker compose exec backend python scripts/verify_admin_http.py",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "dev:backend": "node backend/scripts/start-backend.mjs",
    "predev:next": "node scripts/free-dev-ports.mjs next",
    "dev:next": "npm run dev --prefix frontend",
    "dev:next:full": "concurrently -n next,express,fastapi \"npm:dev:next\" \"npm:dev:api\" \"npm:dev:backend\"",
    "build:next": "npm run build --prefix frontend",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "express": "^4.21.2",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "ssh2": "^1.17.0",
    "vite": "^5.4.8"
  }
}

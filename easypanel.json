{
  "services": [
    {
      "type": "postgres",
      "data": {
        "projectName": "$(PROJECT_NAME)",
        "serviceName": "db",
        "image": "postgres:16-alpine",
        "password": "$(DB_PASSWORD)"
      }
    },
    {
      "type": "app",
      "data": {
        "projectName": "$(PROJECT_NAME)",
        "serviceName": "backend",
        "source": {
          "type": "github",
          "owner": "talebberrouanebenyagoub577-dotcom",
          "repo": "BOB",
          "ref": "main",
          "path": "/backend"
        },
        "build": {
          "type": "dockerfile",
          "dockerfilePath": "./Dockerfile"
        },
        "env": "DATABASE_URL=postgresql+asyncpg://nidhamauto:$(DB_PASSWORD)@organisat_databes:5432/nidhamauto\nSECRET_KEY=$(SECRET_KEY)\nMETA_ACCESS_TOKEN=\nMETA_PIXEL_ID=\nMETA_TEST_EVENT_CODE=\nTIKTOK_ACCESS_TOKEN=\nTIKTOK_PIXEL_ID=\nSNAP_ACCESS_TOKEN=\nSNAP_PIXEL_ID=\nGOOGLE_SHEET_WEBHOOK=",
        "domains": [
          {
            "host": "api.$(EASYPANEL_DOMAIN)",
            "port": 8000
          }
        ]
      }
    },
    {
      "type": "app",
      "data": {
        "projectName": "$(PROJECT_NAME)",
        "serviceName": "frontend",
        "source": {
          "type": "github",
          "owner": "talebberrouanebenyagoub577-dotcom",
          "repo": "BOB",
          "ref": "main",
          "path": "/frontend"
        },
        "build": {
          "type": "dockerfile",
          "dockerfilePath": "./Dockerfile"
        },
        "env": "NEXT_PUBLIC_API_URL=https://api.$(EASYPANEL_DOMAIN)\nNEXT_PUBLIC_ENABLE_PIXELS=true\nNEXT_PUBLIC_META_PIXEL_ID=\nNEXT_PUBLIC_TIKTOK_PIXEL_ID=\nNEXT_PUBLIC_SNAP_PIXEL_ID=",
        "domains": [
          {
            "host": "$(EASYPANEL_DOMAIN)",
            "port": 3000
          }
        ]
      }
    }
  ]
}

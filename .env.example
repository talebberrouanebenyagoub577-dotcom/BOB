# FastAPI in Docker (:8000) + Vite/React: npm run docker:backend  then  npm run dev  or  npm run dev:storefront
# ("dev" skips local uvicorn automatically if :8000 is taken — see backend/scripts/start-backend.mjs.)

ORDERS_WEBHOOK_URL=https://your-webhook-url
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=2
PORT=8787

# docker-compose.yml — db + backend share these. NEVER commit real secrets.
# Generate a strong password locally with:
#   openssl rand -base64 32 | tr -d '+/=' | head -c 32
POSTGRES_USER=nidhamauto
POSTGRES_DB=nidhamauto
POSTGRES_PASSWORD=__CHANGE_ME_RANDOM_32_CHARS__

# Set on the server only. Get this from Apps Script: Deploy → Manage deployments.
GOOGLE_SHEETS_WEBHOOK_URL=

# ── Vite storefront (npm run build → dist/) ──
# Same host: leave empty; nginx must proxy /admin/* to FastAPI (:8000).
# API on subdomain: VITE_ADMIN_API_BASE=https://api.yourdomain.com
VITE_ADMIN_API_BASE=
# Footer link «لوحة التحكم»: hidden in prod unless true. npm run dev shows it automatically.
VITE_SHOW_ADMIN_LINK=false

# docker-compose frontend — إذا منصّة النشر تفرض PORT=80 داخل الحاوية ضَع:
# FRONTEND_INTERNAL_PORT=80
# FRONTEND_PUBLISH_PORT=3000
# ثم ports تصبح تلقائياً "3000:80"
